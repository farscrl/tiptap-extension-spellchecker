{
  "name": "@farscrl/tiptap-extension-spellchecker",
  "version": "2.0.0",
  "description": "A spellchecker extension for the TipTap editor",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "test": "jest --config=jest.config.ts --coverage --passWithNoTests",
    "build": "tsup",
    "lint": "eslint src/**/*.ts",
    "prepare": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farscrl/tiptap-extension-spellchecker.git"
  },
  "author": "far ScRL (https://www.far.ch)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/farscrl/tiptap-extension-spellchecker/issues"
  },
  "homepage": "https://github.com/farscrl/tiptap-extension-spellchecker#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/types": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.1"
  },
  "directories": {
    "lib": "lib"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
